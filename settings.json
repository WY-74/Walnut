{
    "mcpServers": {
        "norm": {
            "command": "D:/projects/Walnut/walnut/Scripts/python.exe",
            "args": [".agents/mcp_tools/norm.py"]
        },
        "data_from_lixinger": {
            "command": "D:/projects/Walnut/walnut/Scripts/python.exe",
            "args": [".agents/mcp_tools/data_from_lixinger.py"],
            "env": {
                "LIXINGER_TOKEN": "${LIXINGER_TOKEN}"
            }
        },
        "data_from_local": {
            "command": "D:/projects/Walnut/walnut/Scripts/python.exe",
            "args": [".agents/mcp_tools/data_from_local.py"]
        },
        "strategy": {
            "command": "D:/projects/Walnut/walnut/Scripts/python.exe",
            "args": [".agents/mcp_tools/strategy.py"]
        }
    },
    "skills": {
        "norm": {
            "skill_path": ".agents/skills/norm",
            "need_tools": ["norm", "data_from_lixinger"]
        },
        "data_from_lixinger": {
            "skill_path": ".agents/skills/data_from_lixinger",
            "need_tools": ["data_from_lixinger", "data_from_local"]
        },
        "verify_strategy": {
            "skill_path": ".agents/skills/verify_strategy",
            "need_tools": ["data_from_local", "strategy"]
        }
    },
    "version": "dev",
    "log_level": "debug",
    "model": "deepseek-v4-pro",
    "runtime_max_loops": 10,
    "sqlite_path": "logs/progress.db"
}
