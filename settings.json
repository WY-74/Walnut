{
    "mcpServers": {
        "norm": {
            "command": "D:/projects/Walnut/walnut/Scripts/python.exe",
            "args": [".agents/mcp_tools/norm.py"]
        },
        "lixinger": {
            "command": "D:/projects/Walnut/walnut/Scripts/python.exe",
            "args": [".agents/mcp_tools/lixinger.py"],
            "env": {
                "LIXINGER_TOKEN": "${LIXINGER_TOKEN}"
            }
        },
        "notion":{
            "command": "npx",
            "args": ["-y", "@notionhq/notion-mcp-server"],
            "env": {
                "NOTION_TOKEN": "${NOTION_TOKEN}"
            }
        }
    },
    "skills": {
        "lixinger": {
            "skill_path": ".agents/skills/lixinger",
            "need_tools": ["norm", "lixinger"]
        },
        "note": {
            "skill_path": ".agents/skills/note",
            "need_tools": ["notion"]
        }
    },
    "version": "dev",
    "model": "deepseek-v4-pro",
    "runtime_max_loops": 10,
    "sqlite_path": "logs/progress.db"
}
